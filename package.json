{
  "name": "@photon-ai/telegram",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Telegram Bot API via Photon's Spectrum gRPC gateway.",
  "license": "MIT",
  "author": "Kumar Vandit <vanditkumarofficial@gmail.com>",
  "keywords": [
    "telegram",
    "telegram-bot",
    "grpc",
    "spectrum",
    "photon"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "PATH=./node_modules/.bin:$PATH buf generate",
    "build": "bun run generate && tsup",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@grpc/grpc-js": "^1.12.4",
    "nice-grpc": "^2.1.10",
    "nice-grpc-common": "^2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@bufbuild/buf": "^1.68.1",
    "@types/bun": "latest",
    "ts-proto": "^2.11.6",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "ultracite": "7.5.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/photon-hq/telegram-ts.git"
  },
  "homepage": "https://photon.codes",
  "bugs": {
    "url": "https://github.com/photon-hq/telegram-ts/issues"
  }
}
