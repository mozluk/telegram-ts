{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": ["!**/dist", "!**/build", "!**/_gen", "!**/drizzle"]
  },
  "linter": {
    "rules": {
      "performance": {
        // SDK index.ts is the published public surface; re-exports are required.
        "noBarrelFile": "off",
        // drizzle-orm requires the schema as a namespace object.
        "noNamespaceImport": "off"
      }
    }
  }
}
